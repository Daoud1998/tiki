# functions/.env.example
# Copy this file to: functions/.env  (DO NOT commit .env)
#
# WhatsApp Cloud API credentials
WHATSAPP_TOKEN=EAAB...your_long_token_here...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=tiki_otp

# Security
OTP_SALT=replace_with_a_long_random_secret

# Optional tuning
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=45

# If you deploy functions to a region other than us-central1
FUNCTIONS_REGION=us-central1
