rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Allowlist admins: وثيقة باسم UID داخل /admins
    // نسمح للمستخدم يقرأ وثيقته فقط (لتجنب أي حلقات مع exists/get)
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Only superadmin can manage admin list (add/remove/change roles)
      allow create, update, delete: if isSuperAdmin();
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function _adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // Super admin: role == "superadmin" (or legacy field superadmin == true)
    function isSuperAdmin() {
      return isAdmin()
        && (_adminData().role == "superadmin" || _adminData().superadmin == true);
    }

    // KYC: يعتمد على kyc_requests/{uid}.status == "approved"
    function isKycApproved(uid) {
      return exists(/databases/$(database)/documents/kyc_requests/$(uid))
        && get(/databases/$(database)/documents/kyc_requests/$(uid)).data.status == "approved";
    }

    function isOwnerId(ownerId) {
      return signedIn() && ownerId == request.auth.uid;
    }

    // User publishing block (set by admin in /users/{uid}).
    function publishingDisabled(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && (
          get(/databases/$(database)/documents/users/$(uid)).data.publishingDisabled == true
          || get(/databases/$(database)/documents/users/$(uid)).data.publishDisabled == true
        );
    }

    // Users (profile)
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Allow users to delete their own account profile.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /users/{uid}/blocks/{blockId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // -------------------------
    // Products
    // -------------------------
    match /products/{productId} {

      // القراءة:
      // - الأدمن: يرى كل شيء
      // - صاحب المنتج: يرى منتجه دائمًا
      // - العامة: ترى فقط المنتجات النشطة وغير المخفية + الموافق عليها
      allow read: if
        isAdmin()
        || isOwnerId(resource.data.sellerId)
        || (
          resource.data.isHidden != true
          && resource.data.status == "active"
          && resource.data.reviewStatus == "approved"
        );

      // -------------------------
      // VIP / Promo حماية: منع المستخدم من تزوير حقول VIP (promo_*)
      // يسمح فقط بطلب VIP (pending/needs_price/none)، أما القبول/الرفض والمدة/الرتبة للأدمن فقط.
      // -------------------------
      function safeAttrsFrom(d) {
        return (d.attrs is map) ? d.attrs : {};
      }

      function isPromoApproved(a) {
        return a.promo_status == "approved" || a.promoStatus == "approved";
      }

      function promoUntilMs(a) {
        return a.promo_until_ms != null ? a.promo_until_ms : a.promoUntilMs;
      }

      // يعتبر منتهي إذا approved وكان until غير موجود أو مرّ وقته.
      function promoExpired(a) {
        return isPromoApproved(a)
          && (promoUntilMs(a) == null || request.time.toMillis() > promoUntilMs(a));
      }

      function promoCreateSafe() {
        let a = safeAttrsFrom(request.resource.data);
        return a.promo_rank == null
          && a.promo_until_ms == null
          && a.promo_appr_at_ms == null
          && a.promo_reject_reason == null
          && a.promoRank == null
          && a.promoUntilMs == null
          && a.promoApprAtMs == null
          && a.promoRejectReason == null
          && a.promo_status != "approved"
          && a.promo_status != "rejected"
          && a.promoStatus != "approved"
          && a.promoStatus != "rejected";
      }

      function ownerPromoUpdateSafe() {
        let oldA = safeAttrsFrom(resource.data);
        let newA = safeAttrsFrom(request.resource.data);
        let changed = newA.diff(oldA).affectedKeys();

        let disallowAdminFields = changed.hasAny([
          "promo_rank",
          "promo_until_ms",
          "promo_appr_at_ms",
          "promo_reject_reason",
          "promoRank",
          "promoUntilMs",
          "promoApprAtMs",
          "promoRejectReason"
        ]);

        // المالك لا يستطيع تغيير الحالة إلى approved/rejected
        // ندعم المفتاحين promo_status و promoStatus؛ إذا تغيّر أحدهما فقط نتحقق منه فقط.
        let promoStatusOk =
          (!changed.hasAny(["promo_status"])
            || (newA.promo_status == null || newA.promo_status in ["pending", "none", "", "needs_price"]))
          && (!changed.hasAny(["promoStatus"])
            || (newA.promoStatus == null || newA.promoStatus in ["pending", "none", "", "needs_price"]));

        // مفاتيح طلب VIP التي قد يكتبها المستخدم
        let promoKeysChanged = changed.hasAny([
          "promo_status",
          "promo_req_at_ms",
          "promo_pkg_id",
          "promo_days",
          "promo_price_mru",
          "promo_tx_id",
          "promo_tier",
          "promoStatus",
          "promoReqAtMs",
          "promoPkgId",
          "promoDays",
          "promoPriceMru",
          "promoTxId",
          "promoTier"
        ]);

        // إذا كان VIP approved وغير منتهي => قفل هذه المفاتيح على المالك.
        // إذا كان منتهي (expired) => نسمح له يعيد الطلب (renew).
        let lockAfterApprovedOk = !isPromoApproved(oldA) || promoExpired(oldA) || !promoKeysChanged;

        return !disallowAdminFields && promoStatusOk && lockAfterApprovedOk;
      }

      // -------------------------
      // View counter (public, safe increment)
      // -------------------------
      function _intOrZero(v) {
        return v == null ? 0 : v;
      }

      // Allow anyone (even guests) to increment viewCount by exactly +1,
      // and optionally write viewCountUpdatedAt. No other fields may change.
      function viewCountOnlyUpdate() {
        return request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly(["viewCount", "viewCountUpdatedAt"])
          && request.resource.data.viewCount == (_intOrZero(resource.data.viewCount) + 1);
      }

      // إنشاء:
      // - نسمح دائمًا بإنشاء إعلان "pending" حتى لو لم يرسل reviewStatus.
      // - إذا كان المستخدم موثق (KYC) يمكنه أيضًا إنشاء إعلان active (اختياري).
      function createReviewStatusOk() {
        let rs = request.resource.data.reviewStatus;
        let kyc = isKycApproved(request.auth.uid);
        // المستخدم العادي: null / pending فقط
        // الموثّق (KYC): مسموح له يضع approved
        return (rs == null || rs == "pending") || (kyc && rs == "approved");
      }

      // إنشاء:
      // - أي مستخدم مسجّل يمكنه إنشاء منتج يخصه
      // - الموثّق (KYC) يستطيع إنشاء إعلان active مباشرة مع reviewStatus=approved
      // - غير الموثّق يستطيع إنشاء active لكن يكون reviewStatus=pending (لن يظهر للعامة حتى يوافق الأدمن)
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && !publishingDisabled(request.auth.uid)
        && (request.resource.data.isHidden != true)
        && (request.resource.data.status in ["pending", "active"])
        && createReviewStatusOk()
        && (
          // إن كان pending => reviewStatus يكون pending أو null
          (request.resource.data.status == "pending"
            && (request.resource.data.reviewStatus == null || request.resource.data.reviewStatus == "pending"))
          // إن كان active =>
          || (request.resource.data.status == "active"
            && (
              // الموثّق لازم approved
              (isKycApproved(request.auth.uid)
                && request.resource.data.reviewStatus == "approved")
              // غير الموثق: pending أو null فقط
              || (!isKycApproved(request.auth.uid)
                && (request.resource.data.reviewStatus == "pending" || request.resource.data.reviewStatus == null))
            ))
        )
        && promoCreateSafe();

      // حذف:
      // - الأدمن فقط
      allow delete: if isAdmin();

      function statusTransitionOk(oldS, newS) {
        return (oldS == newS)
          // من pending إلى active إذا المالك موثق أو المنتج approved
          || (oldS == "pending" && newS == "active"
              && (isKycApproved(request.auth.uid) || resource.data.reviewStatus == "approved"))
          // يسمح للمالك بإدارة حالة الإعلان
          || (oldS == "active" && (newS == "sold" || newS == "paused" || newS == "deleted"))
          || (oldS == "paused" && (newS == "active" || newS == "sold" || newS == "deleted"))
          || (oldS == "sold" && (newS == "active" || newS == "paused" || newS == "deleted"))
          || (oldS == "deleted" && (newS == "active" || newS == "paused"));
      }

      // تعديل:
      // - الأدمن يقدر يعدّل كل شيء
      // - أي شخص يقدر يزيد المشاهدات فقط (قيمة +1)
      // - المالك يقدر يعدّل لكن لا يغير sellerId / reviewStatus / isHidden
      allow update: if isAdmin()
        || viewCountOnlyUpdate()
        || (
          isOwnerId(resource.data.sellerId)
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.reviewStatus == resource.data.reviewStatus
          && request.resource.data.isHidden == resource.data.isHidden
          && statusTransitionOk(resource.data.status, request.resource.data.status)
          && ownerPromoUpdateSafe()
        );
    }

    // Per-product daily view markers (used by incrementUniqueViewPerDay).
    // We allow creating and reading a specific marker doc; we do NOT allow listing.
    match /products/{productId}/views_daily/{markerId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // Home offers
    match /home_offers/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Promo Ads (العروض)
    match /promo_ads/{adId} {
      // العامة ترى الموافق عليه فقط، المالك يرى عرضه، الأدمن يرى الجميع
      allow read: if (resource.data.promoStatus == "approved")
        || isOwnerId(resource.data.ownerUserId)
        || isAdmin();

      // إنشاء:
      // - المستخدم: ينشئ إعلان لنفسه فقط
      // - الأدمن: يستطيع إنشاء إعلان لأي مستخدم (للوحة التحكم)
      allow create: if signedIn()
        && (isOwnerId(request.resource.data.ownerUserId) || isAdmin());

      // Owner can update their ad, but cannot change pricing/approval fields.
      allow update: if isAdmin()
        || (
          signedIn()
          && isOwnerId(resource.data.ownerUserId)
          && request.resource.data.promoStatus == resource.data.promoStatus
          && request.resource.data.promoUntilMs == resource.data.promoUntilMs
          && request.resource.data.promoPriceOverrideMru == resource.data.promoPriceOverrideMru
          && request.resource.data.planId == resource.data.planId
        );

      allow delete: if isAdmin() || isOwnerId(resource.data.ownerUserId);
    }

    // VIP / Promo plans (أسعار باقات VIP للمنتجات)
    match /promo_plans/{tierId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Promo Ad plans (أسعار باقات Promo ads)
    match /promo_ads_plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // KYC requests
    match /kyc_requests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid);

      // Allow the user to delete their own KYC request when deleting their account.
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /kyc_waitlist/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // App settings
    match /app_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Support tickets + messages
    match /supportTickets/{ticketId} {
      // ticketId = uid
      allow read: if isAdmin()
        || (signedIn() && ticketId == request.auth.uid);

      allow create, update: if (signedIn()
          && ticketId == request.auth.uid
          && request.resource.data.userId == request.auth.uid)
        || isAdmin();

      // Allow user to delete their own ticket when deleting their account.
      allow delete: if isAdmin() || (signedIn() && ticketId == request.auth.uid);

      match /messages/{msgId} {
        allow read: if isAdmin()
          || (signedIn() && ticketId == request.auth.uid);

        // المستخدم يكتب رسائله فقط، والأدمن يكتب رسائل admin فقط
        allow create: if (signedIn()
            && ticketId == request.auth.uid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.fromAdmin == false
            // منع المستخدم من إرسال صور (حتى لو حاول إرسال رابط داخل extra)
            && (!request.resource.data.keys().hasAny(["extra"]) || request.resource.data.extra.type != "image"))
          || (isAdmin() && request.resource.data.fromAdmin == true);

        // Allow user to delete messages in their own ticket when deleting their account.
        allow update: if isAdmin();
        allow delete: if isAdmin() || (signedIn() && ticketId == request.auth.uid);
      }
    }

    // Save FCM tokens per user
    match /user_devices/{uid}/tokens/{token} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Inbox (admin writes, user reads own)
    match /user_inbox/{uid}/items/{itemId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Admin (or tools using client SDK) can write items.
      allow create: if isAdmin();

      // User can only mark items as read/unread + timestamps (no content changes).
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "read",
            "readAt",
            "readAtMs",
            "openedAt",
            "openedAtMs",
            "updatedAt",
            "updatedAtMs"
          ])
        );

      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Reports
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;

      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Broadcast notifications (written by Cloud Functions / Admin SDK)
    match /broadcast_notifications/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Admin log (written by Cloud Functions / Admin SDK)
    match /notifications_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Legacy VIP requests (اختياري/قديم)
    match /vip_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.type == "productVip";

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Phone change requests (Admin tool)
    match /phone_change_requests/{reqId} {
      // Admin can create/read/update/delete any request.
      // Optionally, a user can create/read their own request if userId == auth.uid.
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

  }
}
