rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /products/{uid}/{productId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
                   && (request.auth.uid == uid || isAdmin())
                   && request.resource.size < 15 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('video/.*')
                   );
    }

    // Promo ad images (VIP offers carousel).
    match /promo_ads/{uid}/{adId}/{fileName} {
      allow read: if true;
      // Admin-only: promo ads are created/managed by admins from the admin app.
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Report attachments (optional)
    match /reports/{uid}/{reportId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
                   && (request.auth.uid == uid || isAdmin())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Support chat attachments (optional)
    match /support/{uid}/{ticketId}/{fileName} {
      allow read: if true;
      // Admin-only: users cannot upload images in support chat.
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
